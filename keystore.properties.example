# Example Keystore Configuration for Jolsha Android TV
# Copy this file to 'keystore.properties' (DO NOT commit your actual keystore.properties to git)
# and fill in your private signing keystore credentials.

RELEASE_STORE_FILE=../keystore/release.jks
RELEASE_STORE_PASSWORD=your_keystore_password_here
RELEASE_KEY_ALIAS=your_key_alias_here
RELEASE_KEY_PASSWORD=your_key_password_here
