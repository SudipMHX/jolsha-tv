<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- ================= FULLSCREEN EXOPLAYER VIEW ================= -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:shutter_background_color="@color/black"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- ================= TOP HUD SCRIM OVERLAY ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topHudContainer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_hud_top"
        android:paddingStart="@dimen/tv_hud_padding_h"
        android:paddingTop="@dimen/tv_hud_padding_v"
        android:paddingEnd="@dimen/tv_hud_padding_h"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Left Channel Mini Info -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Channel Number -->
            <TextView
                android:id="@+id/textTopChannelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_primary_light"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                tools:text="#001" />

            <!-- Channel Name -->
            <TextView
                android:id="@+id/textTopChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                tools:text="Somoy TV HD" />

            <!-- LIVE Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_badge_live"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/badge_live"
                    android:src="@drawable/ic_live" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/badge_live"
                    android:textColor="@color/status_live"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Top Right Meta Badges & Clock -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Aspect Ratio Badge -->
            <TextView
                android:id="@+id/badgeTopAspectRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_badge_resolution"
                android:textColor="@color/badge_hd_text"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="16:9" />

            <!-- Resolution Badge -->
            <TextView
                android:id="@+id/badgeTopResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_badge_resolution"
                android:textColor="@color/badge_fhd_text"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                tools:text="FHD 1080p" />

            <!-- Current Clock Time -->
            <TextView
                android:id="@+id/textClockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_large_title"
                android:textStyle="bold"
                tools:text="10:45 PM" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= BOTTOM HUD SCRIM OVERLAY ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomHudContainer"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/bg_hud_bottom"
        android:paddingStart="@dimen/tv_hud_padding_h"
        android:paddingEnd="@dimen/tv_hud_padding_h"
        android:paddingBottom="@dimen/tv_hud_padding_v"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Channel Logo Frame -->
        <FrameLayout
            android:id="@+id/hudLogoContainer"
            android:layout_width="@dimen/tv_hud_logo_size"
            android:layout_height="@dimen/tv_hud_logo_size"
            android:background="@drawable/bg_channel_logo_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/imageHudLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:padding="4dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_tv" />

            <TextView
                android:id="@+id/textHudLogoFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/accent_primary_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="BTV" />
        </FrameLayout>

        <!-- Channel Info Block -->
        <LinearLayout
            android:id="@+id/hudInfoBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/hudLogoContainer"
            app:layout_constraintStart_toEndOf="@id/hudLogoContainer"
            app:layout_constraintTop_toTopOf="@id/hudLogoContainer">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textHudChannelNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_primary_light"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"
                    tools:text="#001" />

                <TextView
                    android:id="@+id/textHudCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_resolution"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_badge"
                    tools:text="BANGLA NEWS" />
            </LinearLayout>

            <TextView
                android:id="@+id/textHudChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_hero"
                android:textStyle="bold"
                tools:text="Somoy TV HD" />
        </LinearLayout>

        <!-- TV Controls Action Bar (Focusable Pills) -->
        <LinearLayout
            android:id="@+id/hudActionBar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_hud_action_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Aspect Ratio Button -->
            <LinearLayout
                android:id="@+id/buttonAspectRatio"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_action_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/action_aspect_ratio"
                    android:src="@drawable/ic_aspect_ratio"
                    app:tint="@color/color_action_button_icon" />

                <TextView
                    android:id="@+id/textAspectAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Fit"
                    android:textColor="@color/color_action_button_text"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Audio Track Selector Button -->
            <LinearLayout
                android:id="@+id/buttonAudioTracks"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_action_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/action_audio_tracks"
                    android:src="@drawable/ic_audio_track"
                    app:tint="@color/color_action_button_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/action_audio_tracks"
                    android:textColor="@color/color_action_button_text"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Favorite Star Button -->
            <LinearLayout
                android:id="@+id/buttonFavorite"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_action_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/imageHudFavoriteStar"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/category_favorites"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/color_action_button_icon" />

                <TextView
                    android:id="@+id/textHudFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Star"
                    android:textColor="@color/color_action_button_text"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Quick Guide Button -->
            <LinearLayout
                android:id="@+id/buttonQuickGuide"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_action_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/action_quick_guide"
                    android:src="@drawable/ic_tv"
                    app:tint="@color/color_action_button_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/action_quick_guide"
                    android:textColor="@color/color_action_button_text"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= QUICK CHANNEL GUIDE (SIDE DRAWER) ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quickGuideDrawer"
        android:layout_width="@dimen/tv_drawer_width"
        android:layout_height="match_parent"
        android:background="@drawable/bg_side_drawer"
        android:clickable="true"
        android:focusable="false"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <!-- Drawer Header -->
        <TextView
            android:id="@+id/textDrawerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Quick Channel Guide"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_large_title"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/buttonCloseDrawer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/buttonCloseDrawer"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:focusable="true"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="@id/textDrawerTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/textDrawerTitle" />

        <!-- Subtitle Hint -->
        <TextView
            android:id="@+id/textDrawerSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Press OK to switch • Back to dismiss"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_size_caption"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textDrawerTitle" />

        <!-- Quick Channel List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerQuickChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textDrawerSubtitle"
            tools:itemCount="6"
            tools:listitem="@layout/item_quick_channel" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= BUFFERING SPINNER ================= -->
    <LinearLayout
        android:id="@+id/playerBufferingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="20dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/playback_buffering"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ================= ERROR BANNER OVERLAY ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerErrorView"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/imageErrorIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/playback_error_title"
            android:src="@drawable/ic_error_outline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textErrorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/playback_error_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_large_title"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageErrorIcon"
            app:layout_constraintTop_toTopOf="@id/imageErrorIcon" />

        <TextView
            android:id="@+id/textErrorMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/playback_error_desc"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textErrorTitle"
            app:layout_constraintTop_toBottomOf="@id/textErrorTitle" />

        <!-- Error Actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_button_height"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textErrorMessage">

            <!-- Next Channel Button -->
            <LinearLayout
                android:id="@+id/buttonNextChannel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_action_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_next_channel"
                    android:textColor="@color/color_action_button_text"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Retry Button -->
            <LinearLayout
                android:id="@+id/buttonRetry"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_action_button"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/action_retry"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/color_action_button_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/action_retry"
                    android:textColor="@color/color_action_button_text"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
