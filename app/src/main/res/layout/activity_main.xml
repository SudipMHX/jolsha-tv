<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/tv_safe_margin_horizontal"
    android:paddingTop="@dimen/tv_safe_margin_vertical"
    android:paddingEnd="@dimen/tv_safe_margin_horizontal"
    android:paddingBottom="@dimen/tv_safe_margin_vertical">

    <!-- ================= TOP HEADER BAR ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_header_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Jolsha Logo Vector -->
        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="@dimen/tv_logo_width"
            android:layout_height="@dimen/tv_logo_height"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo_jolsha"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Total Channel Count Pill Badge -->
        <TextView
            android:id="@+id/badgeChannelCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_badge_resolution"
            android:textColor="@color/accent_primary_light"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageLogo"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="64 CHANNELS" />

        <!-- Search Bar Container (Expands when active) -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="280dp"
            android:layout_height="@dimen/tv_button_height"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_action_button"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonSearch"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/action_search"
                android:src="@drawable/ic_search"
                android:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/inputSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="@dimen/text_size_body" />

            <ImageView
                android:id="@+id/buttonClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close"
                android:focusable="true"
                android:src="@drawable/ic_close"
                android:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Search Button (Pill) -->
        <LinearLayout
            android:id="@+id/buttonSearch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_button_height"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_action_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/recyclerCategories"
            android:nextFocusRight="@+id/buttonSettings"
            android:orientation="horizontal"
            android:paddingStart="@dimen/tv_button_padding_h"
            android:paddingEnd="@dimen/tv_button_padding_h"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonSettings"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageSearchIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/action_search"
                android:src="@drawable/ic_search"
                app:tint="@color/color_action_button_icon" />

            <TextView
                android:id="@+id/textSearchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_search"
                android:textColor="@color/color_action_button_text"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Settings Button (Pill) -->
        <LinearLayout
            android:id="@+id/buttonSettings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_button_height"
            android:background="@drawable/bg_action_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:nextFocusDown="@+id/recyclerCategories"
            android:nextFocusLeft="@+id/buttonSearch"
            android:orientation="horizontal"
            android:paddingStart="@dimen/tv_button_padding_h"
            android:paddingEnd="@dimen/tv_button_padding_h"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageSettingsIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/action_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/color_action_button_icon" />

            <TextView
                android:id="@+id/textSettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_settings"
                android:textColor="@color/color_action_button_text"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= HORIZONTAL CATEGORY ROW ================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCategories"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_category_height"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@+id/buttonSearch"
        android:nextFocusDown="@+id/recyclerChannels"
        android:nextFocusLeft="@+id/recyclerCategories"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        tools:listitem="@layout/item_category_tab" />

    <!-- ================= MAIN CHANNEL GRID ================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@+id/recyclerCategories"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recyclerCategories"
        tools:itemCount="12"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/item_channel_card"
        tools:spanCount="4" />

    <!-- ================= EMPTY STATE CONTAINER ================= -->
    <LinearLayout
        android:id="@+id/emptyStateView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recyclerCategories"
        tools:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/empty_playlist_title"
            android:src="@drawable/ic_tv"
            android:tint="@color/text_muted" />

        <TextView
            android:id="@+id/textEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/empty_playlist_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_large_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textEmptyDesc"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/empty_playlist_desc"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body" />

        <LinearLayout
            android:id="@+id/buttonEmptyAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_button_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_action_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/action_reload"
                android:src="@drawable/ic_refresh"
                app:tint="@color/color_action_button_icon" />

            <TextView
                android:id="@+id/textEmptyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/settings_load_sample"
                android:textColor="@color/color_action_button_text"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= LOADING SPINNER ================= -->
    <LinearLayout
        android:id="@+id/loadingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recyclerCategories"
        tools:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/accent_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/playback_buffering"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
