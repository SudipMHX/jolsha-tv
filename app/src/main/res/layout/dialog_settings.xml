<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/dialog_settings_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:padding="28dp">

    <!-- Header -->
    <ImageView
        android:id="@+id/dialogIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/settings_title"
        android:src="@drawable/ic_settings"
        android:tint="@color/accent_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_large_title"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/dialogIcon"
        app:layout_constraintEnd_toStartOf="@id/dialogButtonClose"
        app:layout_constraintStart_toEndOf="@id/dialogIcon"
        app:layout_constraintTop_toTopOf="@id/dialogIcon" />

    <ImageView
        android:id="@+id/dialogButtonClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_close"
        android:focusable="true"
        android:src="@drawable/ic_close"
        android:tint="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="@id/dialogIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/dialogIcon" />

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/border_card"
        app:layout_constraintTop_toBottomOf="@id/dialogIcon" />

    <!-- Scrollable Settings Rows -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1) Import M3U via SAF -->
            <LinearLayout
                android:id="@+id/rowImportM3U"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_item_height"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/settings_import_m3u"
                    android:src="@drawable/ic_folder_open"
                    android:tint="@color/accent_primary_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_import_m3u"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_import_m3u_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2) Reload Playlist -->
            <LinearLayout
                android:id="@+id/rowReloadPlaylist"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_item_height"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/settings_reload_playlist"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/accent_primary_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reload_playlist"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reload_playlist_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3) Load Default Sample -->
            <LinearLayout
                android:id="@+id/rowLoadSample"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_item_height"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/settings_load_sample"
                    android:src="@drawable/ic_tv"
                    android:tint="@color/accent_primary_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_load_sample"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_load_sample_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4) Default Aspect Ratio -->
            <LinearLayout
                android:id="@+id/rowDefaultAspectRatio"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_item_height"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/settings_default_aspect"
                    android:src="@drawable/ic_aspect_ratio"
                    android:tint="@color/accent_primary_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_default_aspect"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textCurrentAspectValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current: Original / Fit"
                        android:textColor="@color/accent_primary_light"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5) Clear Watch History -->
            <LinearLayout
                android:id="@+id/rowClearHistory"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_item_height"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/settings_clear_history"
                    android:src="@drawable/ic_history"
                    android:tint="@color/accent_primary_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_clear_history"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_clear_history_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6) Reset Favorites -->
            <LinearLayout
                android:id="@+id/rowResetFavorites"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_item_height"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/settings_reset_favorites"
                    android:src="@drawable/ic_favorite_border"
                    android:tint="@color/accent_primary_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reset_favorites"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reset_favorites_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- 7) Developer -->
            <LinearLayout
                android:id="@+id/rowDeveloper"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_item_height"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/settings_developer"
                    android:src="@drawable/ic_developer"
                    android:tint="@color/accent_primary_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_developer"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_developer_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- 8) About Jolsha -->
            <LinearLayout
                android:id="@+id/rowAbout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_item_height"
                android:background="@drawable/bg_dialog_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/settings_about"
                    android:src="@drawable/ic_info"
                    android:tint="@color/accent_primary_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_about"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_about_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
