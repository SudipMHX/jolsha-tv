<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Android TV Theme for Jolsha -->
    <style name="Theme.Jolsha.TV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowOverscan">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/bg_surface</item>
        <item name="colorPrimaryDark">@color/bg_main</item>
        <item name="colorAccent">@color/accent_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- TV Remote Focus Settings -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <!-- Dialog Theme for TV -->
    <style name="Theme.Jolsha.TV.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowOverscan">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.75</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>
</resources>
