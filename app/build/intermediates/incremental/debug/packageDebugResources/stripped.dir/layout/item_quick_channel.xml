<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quickItemRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_quick_item_height"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_quick_channel_item"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Channel Number -->
    <TextView
        android:id="@+id/textQuickNumber"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_primary_light"
        android:textSize="@dimen/text_size_caption"
        android:textStyle="bold"
        tools:text="001" />

    <!-- Channel Logo Frame -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_channel_logo_placeholder">

        <ImageView
            android:id="@+id/imageQuickLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:padding="3dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_tv" />

        <TextView
            android:id="@+id/textQuickFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/accent_primary_light"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="BTV" />
    </FrameLayout>

    <!-- Channel Name & Category -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textQuickName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            tools:text="Channel 24 HD" />

        <TextView
            android:id="@+id/textQuickCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_size_caption"
            tools:text="NEWS" />
    </LinearLayout>

    <!-- Playing Indicator / Favorite Star -->
    <ImageView
        android:id="@+id/imageQuickPlaying"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/badge_live"
        android:src="@drawable/ic_play_arrow"
        android:tint="@color/accent_primary"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
