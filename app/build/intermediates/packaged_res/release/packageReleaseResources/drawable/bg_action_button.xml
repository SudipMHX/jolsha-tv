<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_button_radius" />
            <gradient
                android:angle="45"
                android:startColor="#FFFFB84D"
                android:endColor="#FFFF9E1B"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FFFFE082" />
        </shape>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_button_radius" />
            <solid android:color="@color/accent_secondary" />
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_button_radius" />
            <solid android:color="@color/button_normal" />
            <stroke
                android:width="1dp"
                android:color="@color/button_border" />
        </shape>
    </item>
</selector>
