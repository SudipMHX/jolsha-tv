<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused & Selected -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_category_radius" />
            <gradient
                android:angle="45"
                android:startColor="#FFFFB84D"
                android:endColor="#FFFF9E1B"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FFFFE082" />
        </shape>
    </item>

    <!-- Focused only (Cursor hovering/focused) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_category_radius" />
            <gradient
                android:angle="45"
                android:startColor="#FFFFB84D"
                android:endColor="#FFFF9E1B"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FFFFE082" />
        </shape>
    </item>

    <!-- Selected only (Active category filter) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_category_radius" />
            <solid android:color="@color/accent_amber_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent_primary" />
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_category_radius" />
            <solid android:color="@color/bg_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/border_card" />
        </shape>
    </item>
</selector>
