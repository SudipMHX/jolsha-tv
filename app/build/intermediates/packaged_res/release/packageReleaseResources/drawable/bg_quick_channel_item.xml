<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/bg_card_focused" />
            <stroke
                android:width="2dp"
                android:color="@color/border_card_focused" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/accent_amber_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#0DFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/border_card_subtle" />
        </shape>
    </item>
</selector>
